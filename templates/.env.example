# Template: environment variables for local development.
# Copy to .env (next to docker-compose.yml) and fill in real values.
# .env is git-ignored; this .example file is committed and must never contain
# real secrets. CI gets its values from GitHub Secrets, not from this file.

# ---- docker-compose.yml ports ----------------------------------------------
# Host port for the production nginx container.
DOCS_PORT=8080
# Host port for the live-reloading dev server (--profile dev).
DEV_PORT=3000

# ---- Vercel CLI (optional, only for running `vercel` locally) ----------------
# Create a token at https://vercel.com/account/tokens. In CI these come from
# the VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID repository secrets.
VERCEL_TOKEN=YOUR_TOKEN_HERE
# From .vercel/project.json after `npx vercel link`.
VERCEL_ORG_ID=YOUR_ORG_ID_HERE
VERCEL_PROJECT_ID=YOUR_PROJECT_ID_HERE
